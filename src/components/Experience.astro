---
import Icon from "./Icon.astro";
import Link from "./Link.astro";
import ExperienceTimeline from "./ExperienceTimeline.astro";
import { useTranslations, useCurrentLanguage } from "../i18n/utils";
import {
  getJobs,
  totalYears,
  formatMonth,
  formatDuration,
} from "../lib/experience";

const lang = useCurrentLanguage(Astro.currentLocale);
const t = useTranslations(lang);

const jobs = await getJobs(lang);
const [latest, ...previous] = jobs;
const stats = [
  { value: totalYears(jobs), label: t("experience.years") },
  { value: jobs.length, label: t("experience.companies") },
];

const year = (date: Date) => date.getUTCFullYear();
---

{
  latest && (
    <section id="experience" class="w-full scroll-mt-14 px-6 pb-24">
      <div class="mx-auto max-w-3xl">
        <div class="reveal flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
              {t("experience.title")}
            </h2>
            <span
              class="mt-4 block h-0.5 w-10 rounded-full bg-accent"
              aria-hidden="true"
            />
          </div>
          {/* Label after the number in the DOM, so it's read "years of
              experience: 7"; flex-col-reverse puts the number on top. */}
          <dl class="flex gap-8">
            {stats.map(({ value, label }) => (
              <div class="flex flex-col-reverse">
                <dt class="text-xs text-foreground/60">{label}</dt>
                <dd class="text-3xl font-semibold tracking-tight text-primary tabular-nums">
                  {value}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <ExperienceTimeline jobs={jobs} class="mt-10" />

        {/* Every card links to its job on /experience. Hover and focus share
            the cues: border, company colour, arrow nudge. */}
        <Link
          to={`experience#${latest.slug}`}
          data-astro-prefetch
          class="reveal group mt-8 block rounded-2xl border border-foreground/10 p-6 transition duration-300 hover:border-primary/40 hover:shadow-[0_12px_32px_-16px_rgb(14_15_16/0.25)] focus-visible:border-primary/40 sm:p-8"
          style="--i: 1"
        >
          <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-foreground/60">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/60 px-2.5 py-0.5 font-sans font-medium text-foreground">
              <span class="relative flex size-1.5" aria-hidden="true">
                <span class="absolute inset-0 rounded-full bg-accent/60 motion-safe:animate-ping" />
                <span class="relative size-1.5 rounded-full bg-accent" />
              </span>
              {t("experience.current")}
            </span>
            <span>
              {formatMonth(latest.data.start, lang)} — {t("experience.present")}
            </span>
          </p>

          <div class="mt-5 flex items-start justify-between gap-6">
            <div>
              <h3 class="text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-primary-ink group-focus-visible:text-primary-ink">
                {latest.data.company}
              </h3>
              <p class="mt-1 font-medium text-primary-ink">{latest.data.role}</p>
            </div>
            <Icon
              name="arrowRight"
              class="mt-1.5 size-5 text-foreground/30 transition duration-300 group-hover:translate-x-1 group-hover:text-primary group-focus-visible:translate-x-1 group-focus-visible:text-primary"
            />
          </div>

          <p class="mt-3 max-w-lg text-pretty text-foreground/70">
            {latest.data.summary}
          </p>

          <p class="mt-6 flex flex-col gap-1 border-t border-foreground/10 pt-5 sm:flex-row sm:items-baseline sm:gap-4">
            <span class="shrink-0 text-3xl font-semibold tracking-tight text-primary tabular-nums">
              {latest.data.highlights[0].metric}
            </span>
            <span class="text-pretty text-sm text-foreground/70">
              {latest.data.highlights[0].label}
            </span>
          </p>
        </Link>

        {previous.length > 0 && (
          <ul class="mt-4 grid gap-4 sm:grid-cols-3">
            {previous.map((job, i) => (
              <li class="reveal" style={`--i: ${i + 2}`}>
                <Link
                  to={`experience#${job.slug}`}
                  data-astro-prefetch
                  class="group flex h-full flex-col rounded-2xl border border-foreground/10 p-5 transition duration-300 hover:border-primary/40 hover:shadow-[0_12px_32px_-16px_rgb(14_15_16/0.25)] focus-visible:border-primary/40"
                >
                  <p class="font-mono text-xs text-foreground/60 tabular-nums">
                    {year(job.data.start)} — {job.data.end && year(job.data.end)}
                  </p>
                  <h3 class="mt-3 font-semibold transition-colors duration-300 group-hover:text-primary-ink group-focus-visible:text-primary-ink">
                    {job.data.company}
                  </h3>
                  <p class="mt-0.5 text-sm text-foreground/70">{job.data.role}</p>
                  <p class="mt-auto flex items-center justify-between gap-3 pt-5 text-xs text-foreground/60">
                    {formatDuration(job.months, lang)}
                    <Icon
                      name="arrowRight"
                      class="size-4 text-foreground/30 transition duration-300 group-hover:translate-x-1 group-hover:text-primary group-focus-visible:translate-x-1 group-focus-visible:text-primary"
                    />
                  </p>
                </Link>
              </li>
            ))}
          </ul>
        )}

        <Link
          to="experience"
          data-astro-prefetch
          class="reveal group mt-6 inline-flex items-center gap-2 text-sm font-medium text-foreground/60 transition hover:text-foreground focus-visible:text-foreground"
          style={`--i: ${previous.length + 2}`}
        >
          {t("experience.all")}
          <Icon
            name="arrowRight"
            class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1"
          />
        </Link>
      </div>
    </section>
  )
}
