---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
import { useTranslations, useCurrentLanguage } from "../i18n/utils";

const lang = useCurrentLanguage(Astro.currentLocale);
const t = useTranslations(lang);

// The two contacts that don't get their own button. WhatsApp is a CTA instead,
// and the location is the eyebrow — so nothing appears twice. The visible value
// is the accessible name; no aria-label, so what's read matches what's shown.
const contacts = [
  { icon: "mail", href: `mailto:${profile.email}`, value: profile.email },
  { icon: "linkedin", href: profile.linkedin, value: profile.linkedinHandle },
  { icon: "github", href: profile.github, value: profile.githubHandle },
] as const;
---

<section
  class="flex min-h-[calc(100dvh-3.5rem)] w-full bg-[url('/lines-bg.svg')] bg-cover bg-center bg-no-repeat"
>
  <div
    class="m-auto grid w-full max-w-5xl items-center gap-10 px-6 py-16 md:grid-cols-2 md:gap-14"
  >

    <div class="">
      <div class="relative mx-auto w-44 sm:w-56 md:w-full md:max-w-sm">
        <div
          class="absolute inset-0 translate-x-3 translate-y-3 rounded-3xl border border-accent/70"
          aria-hidden="true"
        >
        </div>
        {/* Cropped to 4:5 and served at the size it is shown (176px on a phone,
            up to 384px), at 1x and 2x. It's the first thing on screen, so it
            loads eagerly and first. */}
        <Image
          src={profile.image}
          alt={t("hero.portraitAlt")}
          width={480}
          height={600}
          widths={[176, 224, 352, 384, 448, 768]}
          sizes="(min-width: 768px) 384px, (min-width: 640px) 224px, 176px"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-4/5 w-full rounded-3xl border border-foreground/10 bg-background object-cover"
        />
      </div>
    </div>
    
    <div class="flex flex-col items-start">
      <p
        class="inline-flex items-center gap-1.5 rounded-full border border-foreground/10 bg-background/60 px-3 py-1 text-xs text-foreground/60 backdrop-blur-sm"
      >
        <Icon name="pin" class="size-3.5 text-accent" />
        {t("hero.location")}
      </p>

      <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">
        {t("hero.name")}
      </h1>
      <p class="mt-2 text-lg font-medium text-primary-ink sm:text-xl">
        {t("hero.role")}
      </p>
      <p class="mt-5 max-w-md text-pretty text-foreground/70">
        {t("hero.description")}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={profile.cv}
          download
          class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-ink bg-primary-ink px-5 py-2.5 text-sm font-medium text-background transition hover:border-foreground hover:bg-foreground focus-visible:border-foreground focus-visible:bg-foreground"
        >
          <Icon name="download" class="size-4" />
          {t("hero.cv")}
        </a>
        <a
          href={`https://wa.me/${profile.phone}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-foreground/15 px-5 py-2.5 text-sm font-medium text-foreground/80 transition hover:border-foreground/30 hover:text-foreground focus-visible:border-foreground/30 focus-visible:text-foreground"
        >
          <Icon name="whatsapp" class="size-4" />
          {t("hero.whatsapp")}
          <span class="sr-only">{t("a11y.newTab")}</span>
        </a>
      </div>

      <ul
        class="mt-8 flex w-full flex-wrap gap-x-6 gap-y-2 border-t border-foreground/10 pt-6 text-sm"
      >
        {
          contacts.map(({ icon, href, value }) => {
            const external = href.startsWith("http");
            return (
              <li>
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-2 text-foreground/60 transition hover:text-foreground focus-visible:text-foreground"
                >
                  <Icon name={icon} class="size-4" />
                  {value}
                  {external && <span class="sr-only">{t("a11y.newTab")}</span>}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
