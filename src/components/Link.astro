---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { HTMLAttributes } from "astro/types";
import { useCurrentLanguage } from "../i18n/utils";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  /** Path without a locale prefix, e.g. "blog", `blog/${slug}` or
      "experience#andesoft". */
  to: string;
}

const { to, ...attrs } = Astro.props;

const lang = useCurrentLanguage(Astro.currentLocale);
const [path, hash] = to.replace(/^\//, "").split("#");
const href = getRelativeLocaleUrl(lang, path) + (hash ? `#${hash}` : "");

// Mark the link to the page you're on, for screen readers and for styling via
// `aria-[current=page]:`. Links to a section (#hash) aren't the page itself.
// Trailing slashes differ between dev and build.
const trim = (path: string) => path.replace(/\/+$/, "") || "/";
const current =
  !hash && trim(href) === trim(Astro.url.pathname) ? "page" : undefined;
---

<a {href} aria-current={current} {...attrs}><slot /></a>
