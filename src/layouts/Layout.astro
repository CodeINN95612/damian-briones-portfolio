---
import {useTranslations, useCurrentLanguage} from "../i18n/utils";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import "../styles/global.css";

interface Props {
  /** Page name, shown before the site name in the tab title. The home page
      leaves it out and gets the name and role instead. */
  title?: string;
  /** Under ~160 characters; shown in search results. Defaults to the home
      page's description. */
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  noindex?: boolean;
  /** schema.org nodes for this page (see src/lib/seo.ts). */
  schema?: object[];
}

const { title: pageTitle, description, ...seo } = Astro.props;

const lang = useCurrentLanguage(Astro.currentLocale);
const t = useTranslations(lang);
const title = pageTitle
  ? `${pageTitle} · ${t("meta.title")}`
  : `${t("meta.title")} · ${t("hero.role")}`;
---


<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/damian-darkbg.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-outfit" preload />
		<Font cssVariable="--font-jetbrains-mono" />
		<Seo {title} description={description ?? t("hero.description")} {...seo} />
		<ClientRouter />
	</head>
	<body transition:animate="fade" class="flex flex-col bg-background text-foreground">
		<a
			href="#main"
			class="sr-only rounded-lg bg-foreground text-sm font-medium text-background focus:not-sr-only focus:px-4 focus:py-2 focus:fixed focus:top-3 focus:left-3 focus:z-60"
		>
			{t("a11y.skip")}
		</a>
		<Nav />
		<main id="main" tabindex="-1" class="flex flex-col justify-center items-center outline-none">
			<slot />
		</main>
			<Footer />
	</body>
</html>

<script>
	// Reveals .reveal elements once as they scroll into view (see global.css).
	// Re-run on every page-load because the ClientRouter swaps the DOM.
	document.addEventListener("astro:page-load", () => {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: "0px 0px -10% 0px" },
		);
		document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
	});
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
	html {
		height: 100%;
	}
	/* min-height, not height: the footer follows tall pages instead of
	   overflowing the body, and stays at the bottom of short ones. */
	body {
		min-height: 100%;
	}
</style>
