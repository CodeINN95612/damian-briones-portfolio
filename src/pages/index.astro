---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Cta from '../components/Cta.astro';
import { useCurrentLanguage } from '../i18n/utils';
import { personSchema, websiteSchema } from '../lib/seo';

const lang = useCurrentLanguage(Astro.currentLocale);
---

<Layout
	schema={[personSchema(lang, Astro.site!), websiteSchema(lang, Astro.site!)]}
>
	<Hero />
	<Services />
	<Skills />
	<Experience />
	<BlogTeaser />
	<Cta />
</Layout>
